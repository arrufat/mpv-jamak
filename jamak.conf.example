# jamak configuration — copy this file to your mpv config dir as
# script-opts/jamak.conf. Everything is optional.
#
# Without an account, downloads are anonymous (5 per day per IP). A free
# account at https://www.opensubtitles.com raises that to 20.
#
# NOTE: credentials are stored in plain text (mpv has no secret store).
# Keep this file out of any public dotfiles repo. Alternatively export
# OPENSUBTITLES_API_KEY, OPENSUBTITLES_USERNAME and OPENSUBTITLES_PASSWORD;
# environment variables override the values below.

username=
password=

# Your own API key (https://www.opensubtitles.com/consumers); empty uses
# the key bundled with jamak
api_key=

# Comma-separated 2-letter language codes, in priority order for ranking
languages=en,ko

# Auto mode (yes/no): on file load, if the file has no subtitle track,
# auto-download when there's an exact moviehash match; otherwise just show a
# hint that results exist (never spends download quota on a guess)
auto=no

# Rank hearing-impaired subtitles ([HI]) above regular ones (yes/no)
prefer_hi=no

# Where to save subtitles when the video's directory is unwritable
# (empty = the jamak folder in mpv's cache directory, e.g. ~/.cache/mpv/jamak/subs)
fallback_dir=
